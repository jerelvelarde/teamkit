  },
  "dependencies": {
    "@copilotkit/teamkit-client": "workspace:*",
    "@copilotkit/teamkit-protocol": "workspace:*",
    "@modelcontextprotocol/server": "2.4.0",
    "commander": "^14.0.3",
    "tsx": "^4.20.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "^22.0.0",
    "ajv": "8.20.0",
    "esbuild": "0.28.2",
    "typescript": "~5.9.3"
  }
}
