# Copy this file to .env at the repository root. `pnpm dev`, `pnpm dev:server`, `pnpm dev:web` and the
# server's `start` and `admin` scripts load it (Node 22.9 or newer). Variables already set in your shell win.
# Docker Compose does not read it; it sets what the containers need itself.

# Postgres the server (and teamkit-admin) connect to
DATABASE_URL=postgres://teamkit@127.0.0.1:54329/teamkit
# Port the server listens on
PORT=8787
# Address the server binds to. Defaults to 127.0.0.1 (this machine only); use 0.0.0.0 inside a container
# or to reach it from other machines.
# HOST=127.0.0.1
# Server address and agent token the teamkit CLI uses (the CLI itself does not read this file; export them)
TEAMKIT_URL=http://127.0.0.1:8787
TEAMKIT_TOKEN=
# Admin token for `teamkit` admin commands (usually saved by `teamkit login` instead)
# TEAMKIT_ADMIN_TOKEN=
# Postgres the server tests create throwaway databases on
TEAMKIT_TEST_DATABASE_URL=postgres://teamkit@127.0.0.1:54329/postgres

# Upstream teamkit-server that the web board proxies /v1/* to (read at run time)
TEAMKIT_SERVER_URL=http://127.0.0.1:8787

# Where people reach the web board; used in sign-in links the server prints
TEAMKIT_PUBLIC_URL=http://127.0.0.1:3000

# Email, for "Email me a sign-in link" on the board's sign-in page. Leave TEAMKIT_SMTP_URL unset to keep it off;
# a person whose 30-day session ends then asks an admin for a sign-in link. docker compose passes both to the server.
# TEAMKIT_SMTP_URL=smtps://user:password@smtp.example.com:465
# TEAMKIT_MAIL_FROM=AG-UI TeamKit <teamkit@example.com>

# The server runs agents' tasks itself. Uncomment to turn that off, or to change how many run at once (default 4).
# TEAMKIT_DISPATCH=off
# TEAMKIT_DISPATCH_CONCURRENCY=4

# Timing, in milliseconds. Defaults shown.
# How long a task claim lasts without being renewed (300000 = 5 minutes)
# TEAMKIT_LEASE_MS=300000
# How often the server looks for expired claims
# TEAMKIT_REAP_INTERVAL_MS=15000
# How long a `teamkit login` device code stays valid
# TEAMKIT_DEVICE_TTL_MS=600000
# A dispatched agent that sends no event for this long is stopped
# TEAMKIT_AGENT_IDLE_MS=120000
# The longest one dispatched run may take, board tool rounds included
# TEAMKIT_AGENT_MAX_RUN_MS=1800000

# Webhook and lead triggers run in the server. Uncomment to turn them off in this process.
# Only one instance per database runs triggers (and Slack posts); the others wait and retry every 30 s.
# TEAMKIT_TRIGGERS=off

# Uncomment when a reverse proxy sets X-Forwarded-For and the server is reachable only through it.
# The login-code rate limit then counts the first X-Forwarded-For address instead of the connection's.
# Leave it off when clients can reach the server directly: they could forge the header.
# TEAMKIT_TRUSTED_PROXY=1

# Slack. Everything below is optional; leave a value empty to keep that part off.
# The bridge (mentions and button clicks) needs both CPK_INTELLIGENCE_API_KEY and
# TEAMKIT_SLACK_CHANNEL_NAME. Outbound posts need only SLACK_BOT_TOKEN.
CPK_INTELLIGENCE_API_KEY=
CPK_INTELLIGENCE_API_URL=
CPK_INTELLIGENCE_WS_URL=
# Name of the Channel to register with Intelligence
TEAMKIT_SLACK_CHANNEL_NAME=
# Room a mention lands in when its Slack channel is not mapped to one
TEAMKIT_SLACK_DEFAULT_ROOM=
# Bot token (xoxb-...) for posting task updates to Slack
SLACK_BOT_TOKEN=
# Slack Web API base; empty means https://slack.com/api
SLACK_API_BASE=
# Signing secret of the Slack app (Basic Information). Turns on /teamkit at <TEAMKIT_PUBLIC_URL>/v1/slack/commands
SLACK_SIGNING_SECRET=

# CopilotKit sends anonymous usage telemetry by default. Uncomment to turn it off,
# for example on a locked-down network or in CI.
# COPILOTKIT_TELEMETRY_DISABLED=true

# Example agents (examples/service-agent). The researcher agent starts only when OPENAI_API_KEY is set.
# OPENAI_API_KEY=
# TEAMKIT_MODEL=
# OPENAI_BASE_URL=
# OPENAI_TIMEOUT_MS=60000
