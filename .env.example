DATABASE_URL=postgres://teamkit@127.0.0.1:54329/teamkit
PORT=8787
TEAMKIT_URL=http://127.0.0.1:8787
TEAMKIT_TOKEN=
TEAMKIT_TEST_DATABASE_URL=postgres://teamkit@127.0.0.1:54329/postgres

# Upstream teamkit-server that the web board proxies /v1/* to (read at run time)
TEAMKIT_SERVER_URL=http://127.0.0.1:8787

# Where people reach the web board; used in sign-in links the server prints
TEAMKIT_PUBLIC_URL=http://127.0.0.1:3000

# The server runs agents' tasks itself. Uncomment to turn that off, or to change how many run at once (default 4).
# TEAMKIT_DISPATCH=off
# TEAMKIT_DISPATCH_CONCURRENCY=4

# Webhook and lead triggers run in the server. Uncomment to turn them off in this process.
# Only one instance per database runs triggers (and Slack posts); the others wait and retry every 30 s.
# TEAMKIT_TRIGGERS=off

# Slack. Everything below is optional; leave a value empty to keep that part off.
# The bridge (mentions and button clicks) needs both CPK_INTELLIGENCE_API_KEY and
# TEAMKIT_SLACK_CHANNEL_NAME. Outbound posts need only SLACK_BOT_TOKEN.
CPK_INTELLIGENCE_API_KEY=
CPK_INTELLIGENCE_API_URL=
CPK_INTELLIGENCE_WS_URL=
# Name of the Channel to register with Intelligence
TEAMKIT_SLACK_CHANNEL_NAME=
# Room a mention lands in when its Slack channel is not mapped to one
TEAMKIT_SLACK_DEFAULT_ROOM=
# Bot token (xoxb-...) for posting task updates to Slack
SLACK_BOT_TOKEN=
# Slack Web API base; empty means https://slack.com/api
SLACK_API_BASE=

# CopilotKit sends anonymous usage telemetry by default. Uncomment to turn it off,
# for example on a locked-down network or in CI.
# COPILOTKIT_TELEMETRY_DISABLED=true
