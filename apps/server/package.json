{
  "name": "@teamkit/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "bin": {
    "teamkit-admin": "./bin/teamkit-admin.mjs"
  },
  "scripts": {
    "test": "node --import tsx --test --test-force-exit --test-timeout=120000 'test/**/*.test.ts'",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "node --watch --env-file-if-exists=../../.env --import tsx src/main.ts",
    "start": "node --env-file-if-exists=../../.env --import tsx src/main.ts",
    "admin": "node --env-file-if-exists=../../.env --import tsx src/admin.ts"
  },
  "dependencies": {
    "@ag-ui/client": "1.0.2",
    "@ag-ui/core": "1.0.2",
    "@copilotkit/channels": "0.12.0",
    "@copilotkit/runtime": "1.88.0",
    "@copilotkit/teamkit-protocol": "workspace:*",
    "@hono/node-server": "^2.1.0",
    "commander": "^14.0.3",
    "hono": "^4.13.0",
    "nodemailer": "^10.6.0",
    "postgres": "^3.4.9",
    "tsx": "^4.20.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "typescript": "~5.9.3",
    "zod": "3.25.76"
  }
}
