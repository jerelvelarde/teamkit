{
  "name": "teamkit",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "test": "pnpm -r --workspace-concurrency=1 test",
    "typecheck": "pnpm -r typecheck",
    "db:up": "scripts/dev-db.sh start",
    "db:down": "scripts/dev-db.sh stop",
    "dev": "pnpm db:up && pnpm --parallel --filter @teamkit/server --filter @teamkit/web dev",
    "dev:server": "pnpm db:up && pnpm --filter @teamkit/server dev",
    "dev:web": "pnpm --filter @teamkit/web dev",
    "smoke": "pnpm --filter @teamkit/web smoke"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3"
  },
  "pnpm": {
    "overrides": {
      "@ag-ui/core": "1.0.2",
      "@ag-ui/client": "1.0.2",
      "@copilotkit/core": "1.88.0",
      "@copilotkit/shared": "1.88.0"
    }
  }
}
